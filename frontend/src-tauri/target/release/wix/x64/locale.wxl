<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch Personal AI Agent</String><String Id="DowngradeErrorMessage">A newer version of Personal AI Agent is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the Personal AI Agent executable to the PATH system environment variable. This allows the Personal AI Agent executable to be called from any location.</String><String Id="InstallAppFeature">Installs Personal AI Agent.</String></WixLocalization>