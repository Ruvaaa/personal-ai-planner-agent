GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# WhatsApp Cloud API (disabled until a Meta app and phone number are configured)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_NGROK_PROXY_TOKEN=
WHATSAPP_ALLOWED_PHONE_NUMBERS=
WHATSAPP_PUBLIC_WEBHOOK_URL=
WHATSAPP_GRAPH_API_VERSION=v26.0
# Optional path; defaults to a per-user app state directory.
# WHATSAPP_STATE_DB=
